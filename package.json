{
  "name": "posters",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit",
    "export": "pnpm build && tsx scripts/export-posters.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "setup:browser": "playwright install chromium",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "astro": "7.1.6",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/qrcode": "1.5.6",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
