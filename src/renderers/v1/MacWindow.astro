---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<!-- Adapted from the window-wrapper pattern in whitphx/slidev-addon-window-mockup (MIT): https://github.com/whitphx/slidev-addon-window-mockup/blob/main/components/WindowMockup.vue -->
<figure class:list={["mac-window", className]}>
  <header class="mac-window__titlebar">
    <span class="mac-window__controls" aria-hidden="true">
      <i class="mac-window__control mac-window__control--close"></i>
      <i class="mac-window__control mac-window__control--minimize"></i>
      <i class="mac-window__control mac-window__control--maximize"></i>
    </span>
    <strong>{title}</strong>
    <span aria-hidden="true"></span>
  </header>
  <div class="mac-window__content">
    <slot />
  </div>
</figure>

<style>
  .mac-window {
    background: #fff;
    border: 0.45mm solid #c8d1db;
    border-radius: 3.5mm;
    box-shadow: 0 3mm 10mm rgba(16, 42, 67, 0.12);
    margin: 0;
    overflow: hidden;
  }

  .mac-window__titlebar {
    align-items: center;
    background: #f0f2f4;
    border-bottom: 0.35mm solid #d3d9df;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 12mm;
    padding: 0 4mm;
  }

  .mac-window__titlebar strong {
    color: #3f4a56;
    font-family: "IBM Plex Sans Variable", sans-serif;
    font-size: 11pt;
    font-weight: 600;
    white-space: nowrap;
  }

  .mac-window__controls {
    display: flex;
    gap: 2mm;
  }

  .mac-window__control {
    border: 0.2mm solid rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    display: block;
    height: 3.2mm;
    width: 3.2mm;
  }

  .mac-window__control--close {
    background: #ff5f57;
  }

  .mac-window__control--minimize {
    background: #febc2e;
  }

  .mac-window__control--maximize {
    background: #28c840;
  }

  .mac-window__content {
    background: #fff;
    overflow: hidden;
  }
</style>
